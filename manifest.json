{
  "manifest_version": 3,
  "name": "LinkedIn Slop Filter",
  "version": "2.0.2",
  "description": "Make low-value feed posts reversible with independent categories and three feed themes.",
  "permissions": ["storage"],
  "host_permissions": ["https://openrouter.ai/*", "https://api.openai.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "LinkedIn Slop Filter"},
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/feed", "https://www.linkedin.com/feed/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["assets/fonts/LexendDeca.ttf"],
    "matches": ["https://www.linkedin.com/*"]
  }]
}
